{
  "manifest_version": 3,
  "name": "ChartForge RSI",
  "version": "3.7.0",
  "key": "",
  "description": "Chart nến, RSI và bộ công cụ vẽ kỹ thuật cho Binance Spot.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://api.binance.com/*",
    "https://www.binance.com/*",
    "wss://stream.binance.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.binance.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/icon32.png"],
      "matches": ["https://www.binance.com/*"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Bật/tắt ChartForge RSI",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
